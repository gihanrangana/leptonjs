{
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.backend.tsbuildinfo",
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "./src",
        "outDir": "./node_modules/.tmp/backend",
        "skipLibCheck": true,
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "types": ["node"],
        "paths": {}
    },
    "include": ["./src/backend"]
}
