{
    "compilerOptions": {
        // "composite": true,
        // "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.backend.tsbuildinfo",
        "skipLibCheck": true,
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "noEmit": true,
        "types": ["node"],
        // "baseUrl": ".",
        "paths": {
            "@shared/*": ["./src/shared/*"]
        }
    },
    "include": ["./src/backend", "./src/shared"]
}
