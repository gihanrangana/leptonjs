{
    "name": "@leptonjs/core",
    "version": "0.1.0-beta.4",
    "description": "LeptonJS Node runtime (app, IPC, native loader).",
    "license": "MIT",
    "type": "commonjs",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "author": "Gihan Rangana <gihanrangana@gmail.com>",
    "homepage": "https://github.com/gihanrangana/leptonjs#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gihanrangana/leptonjs.git",
        "directory": "packages/core"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/copy-overlay.cjs",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "engines": {
        "node": ">=22.23.0"
    },
    "dependencies": {
        "@leptonjs/native": "workspace:*",
        "@leptonjs/registry": "workspace:*",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "typescript": "~6.0.3"
    },
    "publishConfig": {
        "access": "public",
        "tag": "beta"
    }
}
