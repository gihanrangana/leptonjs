{
    "name": "@leptonjs/vite",
    "version": "0.1.0-beta.3",
    "description": "Vite plugin for LeptonJS desktop apps.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "author": "Gihan Rangana <gihanrangana@gmail.com>",
    "homepage": "https://github.com/gihanrangana/leptonjs#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gihanrangana/leptonjs.git",
        "directory": "packages/vite"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
